# Server
PORT=3000
NODE_ENV=development

# Session secret (required — the app refuses to start without this).
# Any long random string; generate one with: openssl rand -hex 32
SESSION_SECRET=
SESSION_IDLE_TIMEOUT_MINUTES=30

# There's no admin username/password here on purpose — the app manages its
# own admin account (created via the first-run "Create Admin Account" screen)
# in DATA_DIR below. Recover a lost password with:
#   docker exec <container-name> npm run reset-admin-password

# Where the admin account + settings are persisted. Mount this as a volume
# (e.g. -v dashboard-data:/app/data) or the admin account is lost whenever
# the container is recreated. Optional — defaults to ./data.
# DATA_DIR=/app/data

# Cookie behavior — set to true only when served over HTTPS
COOKIE_SECURE=false

# Docker connection overrides (all optional — auto-detected by default)
# DOCKER_HOST=tcp://192.168.1.10:2375
# DOCKER_TLS_VERIFY=1
# DOCKER_CERT_PATH=/path/to/certs
# DOCKER_TCP_HOST=192.168.1.10
# DOCKER_TCP_PORT=2375
# DOCKER_TCP_PROTOCOL=http

# CORS — only needed if the frontend is served from a different origin (split-origin dev mode)
# ALLOWED_ORIGIN=http://localhost:5173
