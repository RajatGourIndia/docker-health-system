# Port the dashboard listens on.
PORT=3000
# development or production — affects things like error verbosity.
NODE_ENV=development

# Session secret, signs the session cookie. Optional — leave it blank and
# the app generates one on first boot and persists it in DATA_DIR (the same
# place the admin account lives), so there's nothing to do here for a
# normal single-instance setup.
# Only set this explicitly if you need it pinned to a fixed value — e.g.
# running multiple dashboard instances that must share sessions. If you do,
# any long random string works:
#   macOS/Linux/Git Bash:  openssl rand -hex 32
#   Windows PowerShell:    $b=New-Object byte[] 32;(New-Object Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b);-join($b|ForEach-Object{$_.ToString("x2")})
# SESSION_SECRET=
# How many minutes of no user activity before a login is force-expired.
# Also editable later from the Admin tab.
SESSION_IDLE_TIMEOUT_MINUTES=30

# There's no admin username/password here on purpose — the app manages its
# own admin account (created via the first-run "Create Admin Account" screen)
# in DATA_DIR below. Recover a lost password with:
#   docker exec -it <container-name> npm run reset-admin-password

# Where the admin account, settings, and auto-generated session secret are
# persisted. Mount this as a volume (e.g. -v dashboard-data:/app/data) or
# all three are lost whenever the container is recreated. Optional —
# defaults to ./data.
# DATA_DIR=/app/data

# Cookie behavior — set to true only when served over HTTPS.
COOKIE_SECURE=false

# Docker connection overrides (all optional — auto-detected by default: unix
# socket on Linux/macOS, npipe on Windows).
# Full connection URL — if set, this alone determines how the app connects
# (skips auto-detection entirely). Supports unix://, npipe://, or tcp://.
# DOCKER_HOST=tcp://192.168.1.10:2375
# Enable TLS verification for a TCP connection above.
# DOCKER_TLS_VERIFY=1
# Directory containing ca.pem/cert.pem/key.pem, required if TLS is enabled.
# DOCKER_CERT_PATH=/path/to/certs
# Alternative to DOCKER_HOST: connect over TCP to a specific host/port/
# protocol instead of a URL string. Tried only if the local socket isn't
# reachable and DOCKER_HOST isn't set.
# DOCKER_TCP_HOST=192.168.1.10
# DOCKER_TCP_PORT=2375
# DOCKER_TCP_PROTOCOL=http

# CORS — only needed if the frontend is served from a different origin than
# the API (split-origin dev mode). Never set this to "*" — the app sends
# session cookies, and a wildcard origin with credentials is a real
# vulnerability the app actively refuses to start with.
# ALLOWED_ORIGIN=http://localhost:5173
