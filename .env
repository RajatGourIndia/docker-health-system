# Server
PORT=3000
NODE_ENV=development

# Auth (required — the app refuses to start without these)
DASHBOARD_USERNAME=admin
# Generate with: npm run hash-password
DASHBOARD_PASSWORD_HASH=$2a$12$ACUdnOmadF.cCbjssw4sieYdMX37OJDqFFrlIm86qNw0n831IO1qC
SESSION_SECRET=369f323f3747e9b4cb4feeb6a66c620f6de6e23bd0a9a74ea220ea6438ad3337
SESSION_IDLE_TIMEOUT_MINUTES=30

# Cookie behavior — set to true only when served over HTTPS
COOKIE_SECURE=false

# Docker connection overrides (all optional — auto-detected by default)
# DOCKER_HOST=tcp://192.168.1.10:2375
# DOCKER_TLS_VERIFY=1
# DOCKER_CERT_PATH=/path/to/certs
DOCKER_TCP_HOST=ip172-18-0-3-abcde-2375.direct.labs.play-with-docker.com
DOCKER_TCP_PORT=443
DOCKER_TCP_PROTOCOL=https

# CORS — only needed if the frontend is served from a different origin (split-origin dev mode)
# ALLOWED_ORIGIN=http://localhost:5173
